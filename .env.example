# Supabase Vibe Host Test Board environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials.

# ──────────────────────────────────────────────────────────────
# Required — Supabase project credentials (non-production only)
# Get these from: Supabase Dashboard > Project Settings > API
# ──────────────────────────────────────────────────────────────

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ──────────────────────────────────────────────────────────────
# Optional — server-only secrets (do NOT use NEXT_PUBLIC_ prefix)
# These should NEVER be exposed to the browser.
# ──────────────────────────────────────────────────────────────

# Service role key — only needed for admin operations (not used in this fixture)
# SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────
# Do NOT commit:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - SUPABASE_JWT_SECRET
#   - DATABASE_URL (or any postgres:// connection string)
#   - Any key containing real credentials
# ──────────────────────────────────────────────────────────────
